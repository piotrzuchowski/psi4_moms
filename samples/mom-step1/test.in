#! STEP (State-Targeted Energy Projection) excited-state SCF for HCHO.
#! Carter-Fenk & Herbert, JCTC 16, 5067 (2020).

molecule hcho {
    0 1
    C  0.000000  0.000000  0.000000
    O  0.000000  0.000000  1.208000
    H  0.000000  0.943102 -0.544500
    H  0.000000 -0.943102 -0.544500
    symmetry c1
}

set {
    basis           6-31G
    scf_type        pk
    e_convergence   1.0e-8
    d_convergence   1.0e-8
    guess           sad
    reference       rhf
}

energy('scf')     # ground-state guess for the subsequent excited-state SCF

set {
    reference             uhf
    guess                 read
    mom_start             5
    mom_occ               [8]
    mom_vir               [9]
    mom_step              true
    mom_step_epsilon      0.1
}

import numpy as np

E_step, wfn_step = energy('scf', return_wfn=True)
print(f"HCHO n->pi* STEP/UHF/6-31G : {E_step:20.12f} Eh")

# --- Spin contamination ---
# <S^2>_obs = <S^2>_exact + (min(na,nb) - ||C_a^T S C_b||_F^2_occ)
Ca = np.asarray(wfn_step.Ca())
Cb = np.asarray(wfn_step.Cb())
S  = np.asarray(wfn_step.S())
na = wfn_step.nalpha()
nb = wfn_step.nbeta()
M  = Ca[:, :na].T @ S @ Cb[:, :nb]
dS = min(na, nb) - float((M * M).sum())
nm = (na - nb) / 2.0
s2_exact    = abs(nm) * (abs(nm) + 1.0)
s2_observed = s2_exact + dS
print(f"<S^2>:  exact   = {s2_exact:.4f}")
print(f"        observed = {s2_observed:.4f}")
print(f"        contamination dS = {dS:.4f}")
print(f"(UHF open-shell singlet from HOMO->LUMO typically has <S^2> ~ 1)")
